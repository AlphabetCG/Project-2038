  m_Script: {fileID: 11500000, guid: 109bbe8d55261f640a88e41cc91a720c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  template: '"I knew you''d come back here.

    I knew you''d be shocked by what
    you saw.

    I''m truly sorry I couldn''t be there to

    welcome you. Certain
    events have made

    it impossible for me to remain here

    any longer. I
    hope you can forgive me.

    May I be of use to you...


    TaVChai

    {tavchai_hex}.

    From
    the 16th floor to here."'
